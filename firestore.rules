rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: TimestampInfo
    function isValidTimestampInfo(ts) {
      return ts is map &&
             ts.keys().hasAll(['location', 'date', 'time', 'capturedAt']) &&
             ts.keys().hasOnly(['location', 'date', 'time', 'capturedAt']) &&
             ts.location is string && ts.location.size() >= 1 && ts.location.size() <= 300 &&
             ts.date is string && ts.date.size() >= 1 && ts.date.size() <= 100 &&
             ts.time is string && ts.time.size() >= 1 && ts.time.size() <= 100 &&
             ts.capturedAt is string && ts.capturedAt.size() >= 1 && ts.capturedAt.size() <= 200;
    }

    // Validation Blueprint: Quote
    function isValidQuote(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.author is string && data.author.size() >= 1 && data.author.size() <= 200 &&
             data.tags is list && data.tags.size() <= 15 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 60)) &&
             isValidTimestampInfo(data.timestampInfo) &&
             data.sourceWork is string && data.sourceWork.size() <= 300 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
             data.onlinePopularityScore is int && data.onlinePopularityScore >= 0 && data.onlinePopularityScore <= 100 &&
             data.personalNote is string && data.personalNote.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: DailyQuote
    function isValidDailyQuote(data) {
      return data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.author is string && data.author.size() >= 1 && data.author.size() <= 200 &&
             data.sourceWork is string && data.sourceWork.size() <= 300 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
             data.tags is list && data.tags.size() <= 15 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 60)) &&
             data.onlinePopularityScore is int && data.onlinePopularityScore >= 0 && data.onlinePopularityScore <= 100 &&
             data.popularOnlineContext is string && data.popularOnlineContext.size() <= 500 &&
             data.era is string && data.era.size() <= 100 &&
             data.dayKey is string && data.dayKey.size() >= 1 && data.dayKey.size() <= 64 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: FamilyCircle (Zero-Trust Google Social Circle)
    function isCircleMember(circleData) {
      return isSignedIn() && (
        request.auth.uid in circleData.memberUids ||
        (request.auth.token.email != null && request.auth.token.email in circleData.memberEmails)
      );
    }

    function isValidFamilyCircle(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.inviteCode is string && data.inviteCode.size() >= 1 && data.inviteCode.size() <= 32 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.ownerEmail is string && data.ownerEmail.size() >= 1 && data.ownerEmail.size() <= 200 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 20 &&
             data.memberUids[0] is string && data.memberUids[0].size() <= 128 &&
             data.memberEmails is list && data.memberEmails.size() >= 1 && data.memberEmails.size() <= 20 &&
             data.memberEmails[0] is string && data.memberEmails[0].size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: FamilySharedQuote (Zero-Trust Shared Quote)
    function canAccessFamilySharedQuote(data) {
      return isSignedIn() && (
        request.auth.uid in data.allowedMemberUids ||
        (request.auth.token.email != null && request.auth.token.email in data.allowedEmails)
      );
    }

    function isValidFamilySharedQuote(data) {
      return data.circleId is string && data.circleId.size() >= 1 && data.circleId.size() <= 128 &&
             data.circleName is string && data.circleName.size() >= 1 && data.circleName.size() <= 100 &&
             data.senderUid is string && data.senderUid == request.auth.uid &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 150 &&
             data.senderEmail is string && data.senderEmail.size() >= 1 && data.senderEmail.size() <= 200 &&
             data.allowedMemberUids is list && data.allowedMemberUids.size() >= 1 && data.allowedMemberUids.size() <= 20 &&
             data.allowedMemberUids[0] is string && data.allowedMemberUids[0].size() <= 128 &&
             data.allowedEmails is list && data.allowedEmails.size() >= 1 && data.allowedEmails.size() <= 20 &&
             data.allowedEmails[0] is string && data.allowedEmails[0].size() <= 200 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.author is string && data.author.size() >= 1 && data.author.size() <= 200 &&
             data.tags is list && data.tags.size() <= 15 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 60)) &&
             isValidTimestampInfo(data.timestampInfo) &&
             data.personalNote is string && data.personalNote.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: UserPreferences
    function isValidUserPreferences(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.selectedInterests is list && data.selectedInterests.size() <= 15 &&
             (data.selectedInterests.size() == 0 || (data.selectedInterests[0] is string && data.selectedInterests[0].size() <= 60)) &&
             data.priorityMode is string && data.priorityMode in ['Balanced', 'Personal Interests', 'Popular Online', 'Recent & Trending'] &&
             data.recentQuoteIds is list && data.recentQuoteIds.size() <= 30 &&
             (data.recentQuoteIds.size() == 0 || (data.recentQuoteIds[0] is string && data.recentQuoteIds[0].size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Collection 0: /daily_quotes/{quoteId}
    match /daily_quotes/{quoteId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                               isValidId(quoteId) &&
                               incoming().keys().hasAll([
                                 'text', 'author', 'sourceWork', 'category', 'tags',
                                 'onlinePopularityScore', 'popularOnlineContext', 'era',
                                 'dayKey', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'text', 'author', 'sourceWork', 'category', 'tags',
                                 'onlinePopularityScore', 'popularOnlineContext', 'era',
                                 'dayKey', 'updatedAt'
                               ]) &&
                               isValidDailyQuote(incoming());
      allow delete: if false;
    }

    // Collection 1: /users/{userId}/saved_quotes/{quoteId}
    match /users/{userId}/saved_quotes/{quoteId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(quoteId) && (resource == null || existing().userId == request.auth.uid);
      allow list: if isOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(quoteId) &&
                       incoming().keys().hasAll([
                         'userId', 'text', 'author', 'tags', 'timestampInfo',
                         'sourceWork', 'category', 'onlinePopularityScore',
                         'personalNote', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'text', 'author', 'tags', 'timestampInfo',
                         'sourceWork', 'category', 'onlinePopularityScore',
                         'personalNote', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidQuote(incoming());

      allow update: if isValidQuote(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(quoteId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'personalNote', 'timestampInfo', 'tags', 'category', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(quoteId) && existing().userId == request.auth.uid;

      // Subcollection: /users/{userId}/saved_quotes/{quoteId}/annotations/{annotationId}
      match /annotations/{annotationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(quoteId) && isValidId(annotationId) && (resource == null || existing().userId == request.auth.uid);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(quoteId) &&
                         isValidId(annotationId) &&
                         incoming().keys().hasAll([
                           'quoteId', 'userId', 'highlightedText', 'startCharIndex',
                           'endCharIndex', 'inkColor', 'noteText', 'timestampLabel', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'quoteId', 'userId', 'highlightedText', 'startCharIndex',
                           'endCharIndex', 'inkColor', 'noteText', 'timestampLabel', 'createdAt'
                         ]) &&
                         incoming().userId is string && incoming().userId == request.auth.uid &&
                         incoming().quoteId is string && incoming().quoteId == quoteId &&
                         incoming().highlightedText is string && incoming().highlightedText.size() >= 1 && incoming().highlightedText.size() <= 1000 &&
                         incoming().startCharIndex is int && incoming().startCharIndex >= 0 && incoming().startCharIndex <= 2000 &&
                         incoming().endCharIndex is int && incoming().endCharIndex >= incoming().startCharIndex && incoming().endCharIndex <= 2000 &&
                         incoming().inkColor is string && incoming().inkColor in ['AMBER_GOLD', 'SAGE_VERDIGRIS', 'OXBLOOD_CARMINE', 'COBALT_ULTRAMARINE'] &&
                         incoming().noteText is string && incoming().noteText.size() >= 1 && incoming().noteText.size() <= 1000 &&
                         incoming().timestampLabel is string && incoming().timestampLabel.size() >= 1 && incoming().timestampLabel.size() <= 120 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time;

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(quoteId) && isValidId(annotationId) && existing().userId == request.auth.uid;
      }
    }

    // Collection 2: /users/{userId}/preferences/{prefId}
    match /users/{userId}/preferences/{prefId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(prefId) && (resource == null || existing().userId == request.auth.uid);
      allow list: if isOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(prefId) &&
                       incoming().keys().hasAll([
                         'userId', 'selectedInterests', 'priorityMode', 'recentQuoteIds', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'selectedInterests', 'priorityMode', 'recentQuoteIds', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserPreferences(incoming());

      allow update: if isValidUserPreferences(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(prefId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       (
                         (incoming().createdAt == existing().createdAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'selectedInterests', 'priorityMode', 'recentQuoteIds', 'updatedAt'
                          ])) ||
                         (incoming().keys().hasAll([
                            'userId', 'selectedInterests', 'priorityMode', 'recentQuoteIds', 'createdAt', 'updatedAt'
                          ]) &&
                          incoming().keys().hasOnly([
                            'userId', 'selectedInterests', 'priorityMode', 'recentQuoteIds', 'createdAt', 'updatedAt'
                          ]))
                       );

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(prefId) && existing().userId == request.auth.uid;
    }

    // Collection 3: /family_circles/{circleId} (Zero-Trust Family Social Circle)
    match /family_circles/{circleId} {
      allow get: if isValidId(circleId) && (resource == null || isCircleMember(existing()));
      allow list: if isCircleMember(existing());

      allow create: if isSignedIn() &&
                       isValidId(circleId) &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll([
                         'name', 'inviteCode', 'ownerUid', 'ownerEmail',
                         'memberUids', 'memberEmails', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'name', 'inviteCode', 'ownerUid', 'ownerEmail',
                         'memberUids', 'memberEmails', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidFamilyCircle(incoming());

      allow update: if isValidFamilyCircle(incoming()) &&
                       isValidId(circleId) &&
                       isCircleMember(existing()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       existing().ownerUid in incoming().memberUids &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'memberUids', 'memberEmails', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(circleId) && existing().ownerUid == request.auth.uid;
    }

    // Collection 4: /family_shared_quotes/{sharedQuoteId} (Zero-Trust Family Shared Quotes)
    match /family_shared_quotes/{sharedQuoteId} {
      allow get: if isValidId(sharedQuoteId) && (resource == null || canAccessFamilySharedQuote(existing()));
      allow list: if canAccessFamilySharedQuote(existing());

      allow create: if isSignedIn() &&
                       isValidId(sharedQuoteId) &&
                       incoming().senderUid == request.auth.uid &&
                       request.auth.uid in incoming().allowedMemberUids &&
                       incoming().keys().hasAll([
                         'circleId', 'circleName', 'senderUid', 'senderName', 'senderEmail',
                         'allowedMemberUids', 'allowedEmails', 'text', 'author', 'tags',
                         'timestampInfo', 'personalNote', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'circleId', 'circleName', 'senderUid', 'senderName', 'senderEmail',
                         'allowedMemberUids', 'allowedEmails', 'text', 'author', 'tags',
                         'timestampInfo', 'personalNote', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidFamilySharedQuote(incoming());

      allow update: if isValidFamilySharedQuote(incoming()) &&
                       isSignedIn() &&
                       isValidId(sharedQuoteId) &&
                       existing().senderUid == request.auth.uid &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'personalNote', 'allowedMemberUids', 'allowedEmails', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(sharedQuoteId) && existing().senderUid == request.auth.uid;
    }

    // Validation Blueprint: MultiplayerSalon (/symposium_rooms/{roomCode})
    function isValidMultiplayerSalon(data) {
      return data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 32 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 120 &&
             data.gameMode is string && data.gameMode in ['LITERARY_TRIVIA_DUEL', 'CO_READING_SALON', 'SYMPOSIUM_ROUNDTABLE'] &&
             data.lifecyclePolicy is string && data.lifecyclePolicy in ['ON_DEMAND_WAKE', 'AUTO_CLOSE_IDLE', 'KEEP_LIVE_PINNED', 'LEASE_TTL'] &&
             data.currentQuoteId is string && data.currentQuoteId.size() >= 1 && data.currentQuoteId.size() <= 128 &&
             data.currentQuoteText is string && data.currentQuoteText.size() >= 1 && data.currentQuoteText.size() <= 2000 &&
             data.currentQuoteAuthor is string && data.currentQuoteAuthor.size() >= 1 && data.currentQuoteAuthor.size() <= 200 &&
             data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 32 &&
             data.participantUids[0] is string && data.participantUids[0].size() <= 128 &&
             data.participantNames is list && data.participantNames.size() >= 1 && data.participantNames.size() <= 32 &&
             data.participantNames[0] is string && data.participantNames[0].size() <= 120 &&
             data.activeScholars is list && data.activeScholars.size() <= 6 &&
             (data.activeScholars.size() == 0 || (data.activeScholars[0] is string && data.activeScholars[0].size() <= 40)) &&
             data.roundNumber is int && data.roundNumber >= 1 && data.roundNumber <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSalonMessage(data) {
      return data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 32 &&
             data.senderUid is string && data.senderUid == request.auth.uid &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
             data.messageType is string && data.messageType in ['MARGINALIA', 'TRIVIA', 'CHAT', 'SCHOLAR'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.quoteSnippet is string && data.quoteSnippet.size() <= 400 &&
             data.scholarHandle is string && data.scholarHandle.size() <= 40 &&
             data.triviaDeltaScore is int && data.triviaDeltaScore >= -500 && data.triviaDeltaScore <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Collection 5: /symposium_rooms/{roomCode} (Tier-B Cloud Salon Relay)
    match /symposium_rooms/{roomCode} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(roomCode) &&
                       incoming().roomCode == roomCode &&
                       incoming().hostUid == request.auth.uid &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().keys().hasAll([
                         'roomCode', 'title', 'hostUid', 'hostName',
                         'gameMode', 'lifecyclePolicy', 'currentQuoteId',
                         'currentQuoteText', 'currentQuoteAuthor',
                         'participantUids', 'participantNames', 'activeScholars',
                         'roundNumber', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'title', 'hostUid', 'hostName',
                         'gameMode', 'lifecyclePolicy', 'currentQuoteId',
                         'currentQuoteText', 'currentQuoteAuthor',
                         'participantUids', 'participantNames', 'activeScholars',
                         'roundNumber', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidMultiplayerSalon(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomCode) &&
                       isValidMultiplayerSalon(incoming()) &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().createdAt == existing().createdAt &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'gameMode', 'lifecyclePolicy',
                         'currentQuoteId', 'currentQuoteText', 'currentQuoteAuthor',
                         'participantUids', 'participantNames', 'activeScholars',
                         'roundNumber', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(roomCode) && existing().hostUid == request.auth.uid;

      // Subcollection: /symposium_rooms/{roomCode}/messages/{messageId}
      match /messages/{messageId} {
        allow get, list: if isSignedIn();

        allow create: if isSignedIn() &&
                         isValidId(roomCode) &&
                         isValidId(messageId) &&
                         incoming().roomCode == roomCode &&
                         incoming().keys().hasAll([
                           'roomCode', 'senderUid', 'senderName', 'messageType',
                           'text', 'quoteSnippet', 'scholarHandle',
                           'triviaDeltaScore', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomCode', 'senderUid', 'senderName', 'messageType',
                           'text', 'quoteSnippet', 'scholarHandle',
                           'triviaDeltaScore', 'createdAt'
                         ]) &&
                         isValidSalonMessage(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(roomCode) && isValidId(messageId) && existing().senderUid == request.auth.uid;
      }
    }

    // Validation Blueprint: MapQuotePin (/map_quote_pins/{pinId})
    function isValidMapQuotePin(data) {
      return data.ownerUid is string && data.ownerUid == request.auth.uid &&
             data.dayKey is string && data.dayKey.size() >= 8 && data.dayKey.size() <= 32 &&
             data.quoteId is string && data.quoteId.size() >= 1 && data.quoteId.size() <= 128 &&
             data.quoteText is string && data.quoteText.size() >= 1 && data.quoteText.size() <= 2000 &&
             data.quoteAuthor is string && data.quoteAuthor.size() >= 1 && data.quoteAuthor.size() <= 200 &&
             data.sourceWork is string && data.sourceWork.size() <= 300 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
             (data.latitude is int || data.latitude is float) && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             (data.longitude is int || data.longitude is float) && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.regionLabel is string && data.regionLabel.size() >= 1 && data.regionLabel.size() <= 200 &&
             data.anonymousAlias is string && data.anonymousAlias.size() >= 1 && data.anonymousAlias.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Validation Blueprint: MapPinIdentity (/map_pin_identities/{pinId})
    function canReadPinIdentity(data) {
      return isSignedIn() && (
        request.auth.uid == data.ownerUid ||
        request.auth.uid in data.connectedUserUids ||
        (request.auth.token.email != null && request.auth.token.email in data.connectedUserEmails)
      );
    }

    function isValidMapPinIdentity(data) {
      return data.pinId is string && data.pinId.size() >= 1 && data.pinId.size() <= 128 &&
             data.ownerUid is string && data.ownerUid == request.auth.uid &&
             data.ownerDisplayName is string && data.ownerDisplayName.size() >= 1 && data.ownerDisplayName.size() <= 150 &&
             data.ownerEmail is string && data.ownerEmail.size() >= 1 && data.ownerEmail.size() <= 200 &&
             data.circleNames is list && data.circleNames.size() <= 20 &&
             (data.circleNames.size() == 0 || (data.circleNames[0] is string && data.circleNames[0].size() <= 100)) &&
             data.personalMarginalia is string && data.personalMarginalia.size() <= 1000 &&
             data.exactLocationLabel is string && data.exactLocationLabel.size() >= 1 && data.exactLocationLabel.size() <= 300 &&
             data.connectedUserUids is list && data.connectedUserUids.size() >= 1 && data.connectedUserUids.size() <= 50 &&
             data.connectedUserUids[0] is string && data.connectedUserUids[0].size() <= 128 &&
             data.connectedUserEmails is list && data.connectedUserEmails.size() >= 1 && data.connectedUserEmails.size() <= 50 &&
             data.connectedUserEmails[0] is string && data.connectedUserEmails[0].size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Collection 6: /map_quote_pins/{pinId} (Public Zero-Trust Daily Quote Pins - Once-a-day per user, no PII)
    match /map_quote_pins/{pinId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(pinId) &&
                       pinId == request.auth.uid + '_' + incoming().dayKey &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerUid', 'dayKey', 'quoteId', 'quoteText', 'quoteAuthor',
                         'sourceWork', 'category', 'latitude', 'longitude',
                         'regionLabel', 'anonymousAlias', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'dayKey', 'quoteId', 'quoteText', 'quoteAuthor',
                         'sourceWork', 'category', 'latitude', 'longitude',
                         'regionLabel', 'anonymousAlias', 'createdAt'
                       ]) &&
                       isValidMapQuotePin(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(pinId) && existing().ownerUid == request.auth.uid;
    }

    // Collection 7: /map_pin_identities/{pinId} (Zero-Trust Identity & Marginalia - Friends/Connected Circles ONLY)
    match /map_pin_identities/{pinId} {
      allow get: if isValidId(pinId) && (resource == null || canReadPinIdentity(existing()));
      allow list: if canReadPinIdentity(existing());

      allow create: if isSignedIn() &&
                       isValidId(pinId) &&
                       incoming().pinId == pinId &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().connectedUserUids &&
                       incoming().keys().hasAll([
                         'pinId', 'ownerUid', 'ownerDisplayName', 'ownerEmail',
                         'circleNames', 'personalMarginalia', 'exactLocationLabel',
                         'connectedUserUids', 'connectedUserEmails', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'pinId', 'ownerUid', 'ownerDisplayName', 'ownerEmail',
                         'circleNames', 'personalMarginalia', 'exactLocationLabel',
                         'connectedUserUids', 'connectedUserEmails', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidMapPinIdentity(incoming());

      allow update: if isSignedIn() &&
                       isValidId(pinId) &&
                       isValidMapPinIdentity(incoming()) &&
                       existing().ownerUid == request.auth.uid &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().pinId == existing().pinId &&
                       incoming().createdAt == existing().createdAt &&
                       request.auth.uid in incoming().connectedUserUids &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'connectedUserUids', 'connectedUserEmails', 'circleNames',
                         'personalMarginalia', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(pinId) && existing().ownerUid == request.auth.uid;
    }
  }
}
